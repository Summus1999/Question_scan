{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local Windows main window access for the stage-1 shell, settings, and tray visibility commands.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-load-app-state",
    "allow-save-settings",
    "allow-reset-settings",
    "allow-show-main-window",
    "allow-hide-main-window",
    "allow-toggle-main-window",
    "allow-set-tray-status",
    "allow-send-ai-request",
    "allow-clear-cache",
    "allow-list-history",
    "allow-delete-history-entry",
    "allow-clear-history"
  ],
  "platforms": ["windows"]
}
